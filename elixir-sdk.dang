"""
Manage Dagger modules that use the Elixir SDK.
"""
type ElixirSdk {
  # Matches `"sdk": { "source": "elixir" }` in a legacy dagger.json.
  let legacyConfigPattern = "\"sdk\"\\s*:\\s*\\{[^}]*\"source\"\\s*:\\s*\"elixir\""

  # Matches a `[runtime]` table whose source names this SDK's runtime in a CLI
  # 1.0 dagger-module.toml. Accepts the bare `elixir` name as well as the remote
  # runtime ref, with or without a version suffix.
  let tomlConfigPattern = "\\[runtime\\][^\\[]*source\\s*=\\s*\"(elixir|github\\.com/dagger/elixir-sdk/runtime[^\"]*)\""

  """
  Config filenames that mark a Dagger module root: the CLI 1.0
  `dagger-module.toml` (workspace-managed modules) and the legacy `dagger.json`.
  A managed module is discovered by whichever it uses.
  """
  let moduleConfigFilenames: [String!]! = ["dagger-module.toml", "dagger.json"]

  """
  Marker filename that skips generate when found at or above an Elixir SDK module root.
  """
  pub skipGenerateFilename: String! = ".dagger-elixir-sdk-skip-generate"

  """
  Starter template rendered into a new module: default*, empty.

  `default` is a small working module; `empty` is a bare object module. As an
  SDK setting this is settable per workspace or per scope, which is how a
  template reaches `generateScope` now that the engine owns the init call and
  its signature is fixed.
  """
  pub template: String! = "default"

  """
  Runtime source to write into modules created by this SDK.

  Elixir has no built-in engine runtime, so new modules point at this
  repository's build-only runtime module.
  """
  pub targetRuntime: String! { "github.com/dagger/elixir-sdk/runtime" }

  """
  Return init templates tracked by this module.

  Templates live under templates/<name> and are materialized into the new
  module before generation. Passing an empty template to init uses the module
  default.
  """
  pub templates: [Template!]! {
    if (currentModule.source.exists("templates")) {
      let root = currentModule.source.directory("templates")
      root.entries.map { name =>
        Template(
          name: name.trimSuffix("/"),
          source: root.directory(name),
        )
      }
    } else {
      directory.entries.map { name =>
        Template(
          name: name,
          source: directory,
        )
      }
    }
  }

  """
  Find the Elixir SDK module root that contains `ws.cwd`.

  The engine uses this to decide which scope a command run from a subdirectory
  belongs to. Returns a workspace-root-relative parent of `ws.cwd`, or null when
  the cwd is not inside a module this SDK owns.
  """
  pub findClientRoot(ws: Workspace!): String {
    let foundToml = ws.findUp("dagger-module.toml")
    let foundJson = ws.findUp("dagger.json")
    let tomlBase = if (foundToml == null) { null } else { configDir(foundToml, "dagger-module.toml") }
    let jsonBase = if (foundJson == null) { null } else { configDir(foundJson, "dagger.json") }

    # The nearest config wins when a partially migrated tree holds both.
    if (tomlBase != null and pathDepth(tomlBase) >= pathDepth(jsonBase)) {
      if (usesElixirSdk(ws, tomlBase, "dagger-module.toml", tomlConfigPattern)) { tomlBase } else { null }
    } else if (jsonBase != null) {
      if (usesElixirSdk(ws, jsonBase, "dagger.json", legacyConfigPattern)) { jsonBase } else { null }
    } else {
      null
    }
  }

  """
  Generate one Elixir SDK scope.

  `ws.cwd` is the scope the engine persisted for this SDK. A scope without a
  `dagger-module.toml` is a module being created: the selected template is
  rendered into it and a manifest pointing at this SDK's runtime is written
  before generation. An existing manifest is left alone, so a module keeps
  whatever dependencies and engine version it already declares.

  Generation itself vendors the Elixir SDK and the API bindings generated from
  the module's own schema into `<module source>/dagger_sdk`. The engine orders
  the calls, generating a module's local dependencies before the module itself.

  If the generate skip marker is present at or above the scope, the scope is
  left untouched.
  """
  pub generateScope(
    ws: Workspace!,
    isModule: Boolean!,
    name: String!,
    clients: [ModuleSource!]!,
  ): Workspace! {
    if (clients.length > 0) {
      raise "the Elixir SDK does not generate standalone clients yet; " +
        "remove the client target from this scope"
    } else if (!isModule) {
      ws
    } else {
      let initialized = if (exists(ws, "dagger-module.toml")) {
        ws
      } else {
        initializedModule(ws, name)
      }

      Mod(
        rootPath: normalizePath(ws.cwd),
        ws: initialized,
        skipGenerateFilename: skipGenerateFilename,
      ).generatedWorkspace(initialized)
    }
  }

  """
  Seed a new module in `ws.cwd`: the selected template plus the manifest naming
  this SDK's runtime.

  The engine validates that a `dagger-module.toml` exists at the scope once
  `generateScope` returns, so unlike the legacy `initModule` path this writes it
  rather than leaving it to the engine.
  """
  let initializedModule(ws: Workspace!, name: String!): Workspace! {
    let selectedTemplate = if (template == "") { "default" } else { template }

    if (currentModule.source.exists("templates/" + selectedTemplate) == false) {
      raise "unknown init template: " + template
    } else {
      ws
        .withDirectory(".", renderedTemplate(name, selectedTemplate))
        .withNewFile("dagger-module.toml", moduleManifest(name))
    }
  }

  """
  The manifest written for a module this SDK creates.

  Elixir has no engine-bundled runtime, so `[runtime] source` names this
  repository's build-only runtime module rather than a short name.
  """
  let moduleManifest(name: String!): String! {
    "name = " + JSON.encode(name) + "\n" +
      "engineVersion = \"v1.0.0-0\"\n\n" +
      "[runtime]\n" +
      "  source = " + JSON.encode(targetRuntime) + "\n"
  }

  """
  Whether a path exists relative to `ws.cwd`.
  """
  let exists(ws: Workspace!, path: String!): Boolean! {
    ws.directory(".", include: [path]).exists(path)
  }

  """
  Return the Elixir SDK module at or above a workspace path.

  When `findUp` is true, `path` may point inside the module.
  """
  pub mod(ws: Workspace!, path: String! = ".", findUp: Boolean! = true): Mod! {
    let modPath = if (findUp) {
      let foundToml = ws.findUp("dagger-module.toml", path)
      let foundJson = ws.findUp("dagger.json", path)
      let tomlBase = if (foundToml == null) { null } else { configDir(foundToml, "dagger-module.toml") }
      let jsonBase = if (foundJson == null) { null } else { configDir(foundJson, "dagger.json") }

      if (tomlBase == null and jsonBase == null) {
        raise "no Dagger module found containing path: " + path
      } else if (tomlBase != null and pathDepth(tomlBase) > pathDepth(jsonBase)) {
        validateConfig(ws, tomlBase, "dagger-module.toml", tomlConfigPattern, path)
      } else if (jsonBase != null) {
        validateConfig(ws, jsonBase, "dagger.json", legacyConfigPattern, path)
      } else {
        raise "no Dagger module found containing path: " + path
      }
    } else {
      normalizePath(path)
    }

    Mod(
      rootPath: modPath,
      ws: ws,
      skipGenerateFilename: skipGenerateFilename,
    )
  }

  """
  Render an Elixir template with the requested module name.
  """
  let renderedTemplate(name: String!, templateName: String!): Directory! {
    container
      .from("golang:1.25-alpine")
      .withoutEntrypoint
      .withMountedCache("/go/pkg/mod", cacheVolume("go-mod"))
      .withMountedCache("/root/.cache/go-build", cacheVolume("go-build"))
      .withDirectory("/helper", currentModule.source.directory("helpers/render-template"))
      .withDirectory("/template", currentModule.source.directory("templates/" + templateName))
      .withWorkdir("/helper")
      .withExec(["go", "build", "-o", "/usr/local/bin/render-template", "."])
      .withExec(["render-template", name, "/template", "/rendered"])
      .directory("/rendered")
  }

  let normalizePath(path: String!): String! {
    let normalized = path.trimPrefix("./").trimPrefix("/").trimSuffix("/")
    if (normalized == "") { "." } else { normalized }
  }

  let pathDepth(path: String): Int! {
    if (path == null) { -1 } else if (path == ".") { 0 } else { path.split("/").length }
  }

  let configDir(path: String!, filename: String!): String! {
    normalizePath(path.trimPrefix("/").trimSuffix(filename))
  }

  """
  Whether the module config at `base` declares this SDK's runtime.

  A missing or unreadable config counts as a foreign module rather than an
  error: `findClientRoot` has to answer for any cwd the user runs from.
  """
  let usesElixirSdk(ws: Workspace!, base: String!, filename: String!, pattern: String!): Boolean! {
    let configPath = if (base == ".") { filename } else { base + "/" + filename }
    ws
      .directory("/", include: [configPath])
      .file(configPath)
      .search(pattern: pattern, multiline: true, dotall: true, limit: 1)
      .{{id}}
      .length > 0 rescue { err: Error => false }
  }

  let validateConfig(ws: Workspace!, base: String!, filename: String!, pattern: String!, requestedPath: String!): String! {
    if (usesElixirSdk(ws, base, filename, pattern)) {
      base
    } else {
      raise "Dagger module does not use the Elixir SDK: " + requestedPath
    }
  }
}
