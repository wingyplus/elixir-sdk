let modSourceDirPath = "/src"
let genDir = "dagger_sdk"
let elixirImage = "elixir:1.20.2-otp-29-alpine@sha256:c68e45a3840f5cec60b9485cf3af8e82d3d749793a2eb4b442628e6ba9711b6f"

# Zig release the code generator is built with. The script installs it into
# /opt/zig, verifying the archive for the engine's architecture against the
# SHA-256 published in https://ziglang.org/download/index.json. Kept in step
# with the same constants in mod.dang and .dagger/modules/dev/main.dang.
let zigVersion = "0.16.0"
let zigInstallScript = "set -eu; version=$1; arch=$(uname -m); case \"$arch\" in x86_64) sum=70e49664a74374b48b51e6f3fdfbf437f6395d42509050588bd49abe52ba3d00;; aarch64) sum=ea4b09bfb22ec6f6c6ceac57ab63efb6b46e17ab08d21f69f3a48b38e1534f17;; *) echo \"no Zig $version archive for $arch\" >&2; exit 1;; esac; wget -qO /tmp/zig.tar.xz \"https://ziglang.org/download/$version/zig-$arch-linux-$version.tar.xz\"; echo \"$sum  /tmp/zig.tar.xz\" | sha256sum -c -; mkdir -p /opt/zig; tar -xJf /tmp/zig.tar.xz -C /opt/zig --strip-components=1; rm /tmp/zig.tar.xz"

"""
Runtime module for the Elixir SDK.

Builds and packages a module from its vendored sources. Code generation is owned
by the Elixir SDK's `generate` step (`dagger generate`): modules commit their
generated `dagger_sdk/` directory and this runtime compiles those committed
sources. A module that has not been generated yet (e.g. freshly scaffolded by
`dagger module init`, before its first `dagger generate`) still loads: the
runtime vendors the SDK and generates the API bindings on the fly from the
engine-provided introspection schema, so `dagger generate` itself can load the
module and repair it.
"""
type ElixirSdkRuntime {
  """
  No-op: code generation is owned by `dagger generate`. Modules commit the
  generated files, so the engine skips codegen at module load. Returning the
  module source unchanged keeps the SDK code-generator contract satisfied without
  generating anything.
  """
  pub codegen(
    modSource: ModuleSource!,
    introspectionJson: File,
  ): GeneratedCode! {
    generatedCode(code: modSource.contextDirectory)
  }

  """
  Compile the module and return a container that runs it. The module is
  self-contained — the Elixir SDK is vendored under `dagger_sdk/` and `mix.exs`
  depends on it by path — so `mix deps.get` only fetches third-party
  dependencies.

  Committed `dagger_sdk/` sources are used as-is. When they are missing (the
  module was never generated), an equivalent `dagger_sdk/` is generated from
  `introspectionJson` and overlaid before compiling; `dagger generate` remains
  what writes it to the workspace.

  `introspectionJson` is deliberately required: the engine only provides it to
  runtimes that do not declare it optional, and it is what makes an ungenerated
  module loadable.
  """
  pub moduleRuntime(
    modSource: ModuleSource!,
    introspectionJson: File!,
  ): Container! {
    let modName = modSource.moduleName
    let subPath = modSource.sourceSubpath
    let contextDir = modSource.contextDirectory

    let sourceDir = if (hasGeneratedFiles(contextDir, subPath)) {
      contextDir
    } else {
      contextDir.withDirectory(
        Path(subPath).join(Path(genDir)).string,
        vendoredSdk(introspectionJson),
      )
    }

    let workdir = Path(modSourceDirPath).join(Path(subPath)).string

    baseContainer(container)
      .withMountedDirectory(modSourceDirPath, sourceDir)
      .withWorkdir(workdir)
      .withEnvVariable("MIX_ENV", "prod")
      .withEnvVariable("HEX_CACERTS_PATH", "/etc/ssl/certs/ca-certificates.crt")
      .withExec(["mix", "deps.get", "--only", "prod"])
      .withExec(["mix", "deps.compile"])
      .withExec(["mix", "compile"])
      .withEntrypoint([
        "mix",
        "cmd",
        "--cd",
        workdir,
        "mix",
        "dagger.entrypoint.invoke",
        toElixirModuleName(modName),
      ])
  }

  """
  Whether the module's vendored SDK is committed — `dagger_sdk/mix.exs` exists
  and is non-empty. When it is not, `mix deps.get` would fail on the
  unresolvable `{:dagger, path: "./dagger_sdk"}` dependency, so `moduleRuntime`
  generates the vendored SDK on the fly instead.
  """
  let hasGeneratedFiles(contextDir: Directory!, subPath: String!): Boolean! {
    let relPath = Path(subPath).join(Path(genDir)).join(Path("mix.exs")).string
    let present = contextDir.exists(path: relPath, expectedType: ExistsType.REGULAR_TYPE)
    if (present) { contextDir.file(relPath).size > 0 } else { false }
  }

  """
  The Elixir SDK source shipped alongside this runtime, pulled into the module
  context by the `../sdk` include patterns in dagger-module.toml.
  """
  let sdkSourceDir: Directory! { currentModule.source.directory("../sdk") }

  """
  The SDK as it is vendored into a module: just enough to compile against.

  Kept in step with vendoredSdk in mod.dang, which produces the same directory
  at `dagger generate` time; this one only exists so an ungenerated module can
  load.
  """
  let vendoredSdk(introspectionJSON: File!): Directory! {
    sdkSourceDir
      .filter(include: ["LICENSE", "mix.exs", "mix.lock", ".formatter.exs", "lib/**/*.ex"])
      .withoutDirectory("lib/dagger/gen")
      .withDirectory("lib/dagger/gen", generatedBindings(introspectionJSON))
  }

  """
  The code generator's sources — just enough to build it. Deliberately narrow so
  the build caches across edits to everything else, the generator's own tests
  included.
  """
  let codegenSourceDir: Directory! {
    sdkSourceDir
      .directory("dagger_codegen")
      .filter(include: ["build.zig", "build.zig.zon", "src/**"])
  }

  """
  The code generator, a static Linux executable built from `sdk/dagger_codegen`.

  Built once and reused across schemas: only its own sources and the Zig release
  feed this layer.
  """
  let codegenBinary: File! {
    container
      .from(elixirImage)
      .withExec(["sh", "-c", zigInstallScript, "install-zig", zigVersion])
      .withMountedCache("/root/.cache/zig", cacheVolume("elixir-sdk-zig"))
      .withMountedDirectory("/codegen", codegenSourceDir)
      .withWorkdir("/codegen")
      .withExec(["/opt/zig/zig", "build", "-Doptimize=ReleaseSafe", "--prefix", "/out"])
      .file("/out/bin/dagger_codegen")
  }

  """
  Run the code generator over the module's introspection schema and return the
  generated API bindings, laid out by the generator itself.

  Kept in step with generatedBindings in mod.dang.
  """
  let generatedBindings(introspectionJSON: File!): Directory! {
    container
      .from(elixirImage)
      .withFile("/usr/local/bin/dagger_codegen", codegenBinary)
      .withMountedFile("/schema.json", introspectionJSON)
      .withExec([
        "dagger_codegen",
        "generate",
        "--outdir",
        "/gen",
        "--introspection",
        "/schema.json",
      ])
      .directory("/gen")
  }

  let baseContainer(ctr: Container!): Container! {
    ctr
      .from(elixirImage)
      .withExec(["apk", "add", "--no-cache", "git"])
      .withExec(["mix", "local.hex", "--force"])
      .withExec(["mix", "local.rebar", "--force"])
  }
}

"""
Convert a Dagger module name into an Elixir application name ("my-module" ->
"my_module").

Kept byte-for-byte in step with elixirAppName in
helpers/render-template/main.go, which derives the same name at init time.
"""
let toElixirApplicationName(name: String!): String! {
  name
    .replaceMatches(`([A-Z]+)([A-Z][a-z])`, with: "$1_$2")
    .replaceMatches(`([a-z0-9])([A-Z])`, with: "$1_$2")
    .replaceMatches(`[^A-Za-z0-9]+`, with: "_")
    .trim("_")
    .toLower
}

"""
Convert a Dagger module name into an Elixir module name ("my-module" ->
"MyModule").

Kept byte-for-byte in step with elixirModuleName in
helpers/render-template/main.go: this derives the entrypoint's module name at
call time, that one derives the `defmodule` name at init time, and a divergence
means the entrypoint names a module that does not exist.
"""
let toElixirModuleName(name: String!): String! {
  toElixirApplicationName(name)
    .split("_")
    .map { word => word.rewriteMatches(`^.`) { first => first.string.toUpper } }
    .join("")
}
