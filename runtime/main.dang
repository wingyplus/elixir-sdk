let modSourceDirPath = "/src"
let genDir = "dagger_sdk"
let elixirImage = "elixir:1.20.1-otp-29-alpine@sha256:f50894ff69b0d07b310fe9c97b48b3475568ecccb7f0ccd7c350a789feb395a3"

# Prebuilt code generator image, published from codegen/ by
# `dagger call codegen publish` and pinned by digest. `dagger call codegen pin`
# rewrites this constant here and in mod.dang.
let codegenImage = "docker.io/wingyplus/elixir-sdk-codegen:0.2.1@sha256:4d06dabd5359aefa350e86760555251bedff04a00b4fd36b385ab2da11bc3234"

# Mix's dependencies and build output live on a cache volume, outside the
# source tree, so a rebuild picks up where the last one stopped.
let mixCachePath = "/mix"

# The compiled applications a call runs, copied out of the cache volume.
let buildPath = "/opt/dagger-module"

# The script every call starts the module through.
let entrypointPath = "/usr/local/bin/dagger-module-entrypoint"

# Fetches and compiles in one Mix VM, copies the compiled applications to $1,
# and writes $2: `elixir` with every application on the code path (through
# ERL_LIBS) and the consolidated protocols ahead of them, which is the code path
# `mix run` would set up, without starting Mix.
let buildScript = "set -eu; mix do deps.get --only prod + compile; rm -rf \"$1\"; mkdir -p \"$1\"; cp -RL \"$MIX_BUILD_ROOT/$MIX_ENV/lib\" \"$1/lib\"; pa=''; for dir in \"$1\"/lib/*/consolidated; do if [ -d \"$dir\" ]; then pa=\"$pa -pa $dir\"; fi; done; printf '#!/bin/sh\\nexport ERL_LIBS=%s\\nexec elixir%s \"$@\"\\n' \"$1/lib\" \"$pa\" > \"$2\"; chmod +x \"$2\""

"""
Runtime module for the Elixir SDK.

Builds and packages a module from its vendored sources. Code generation is owned
by the Elixir SDK's `generate` step (`dagger generate`): modules commit their
generated `dagger_sdk/` directory and this runtime compiles those committed
sources. A module that has not been generated yet (e.g. freshly scaffolded by
`dagger module init`, before its first `dagger generate`) still loads: the
runtime vendors the SDK and generates the API bindings on the fly from the
engine-provided introspection schema, so `dagger generate` itself can load the
module and repair it.
"""
type ElixirSdkRuntime {
  """
  No-op: code generation is owned by `dagger generate`. Modules commit the
  generated files, so the engine skips codegen at module load. Returning the
  module source unchanged keeps the SDK code-generator contract satisfied without
  generating anything.
  """
  pub codegen(
    modSource: ModuleSource!,
    introspectionJson: File,
  ): GeneratedCode! {
    generatedCode(code: modSource.contextDirectory)
  }

  """
  Compile the module and return a container that runs it. The module is
  self-contained — the Elixir SDK is vendored under `dagger_sdk/` and `mix.exs`
  depends on it by path — so `mix deps.get` only fetches third-party
  dependencies.

  Committed `dagger_sdk/` sources are used as-is. When they are missing (the
  module was never generated), an equivalent `dagger_sdk/` is generated from
  `introspectionJson` and overlaid before compiling; `dagger generate` remains
  what writes it to the workspace.

  `deps` and `_build` live on a cache volume for this module (see `mixCache`),
  outside the source tree, so a rebuild after an edit leaves it to Mix's own
  staleness tracking to decide what to recompile: usually the module's changed
  files, not the vendored SDK and its dependencies. (A layer cannot do that
  here: a layer built from the source minus `lib/` is still invalidated by an
  edit to `lib/`.) The volume is locked for the duration of a build, and the
  compiled applications are copied out of it, so calls never read a volume
  another build is writing.

  Every call — the module's registration included — starts `elixir` on the
  compiled code rather than going through Mix: one VM instead of two and no
  compile check, which cuts the start-up of each call from about 510ms to 140ms.
  A release would start as fast but strips the documentation chunks the SDK
  reads function descriptions from.

  `introspectionJson` is deliberately required: the engine only provides it to
  runtimes that do not declare it optional, and it is what makes an ungenerated
  module loadable.
  """
  pub moduleRuntime(
    modSource: ModuleSource!,
    introspectionJson: File!,
  ): Container! {
    let modName = modSource.moduleName
    let subPath = modSource.sourceSubpath
    let contextDir = modSource.contextDirectory

    let sourceDir = if (hasGeneratedFiles(contextDir, subPath)) {
      contextDir
    } else {
      contextDir.withDirectory(
        Path(subPath).join(Path(genDir)).string,
        vendoredSdk(introspectionJson),
      )
    }

    let workdir = Path(modSourceDirPath).join(Path(subPath)).string

    baseContainer(container)
      .withEnvVariable("MIX_ENV", "prod")
      .withEnvVariable("MIX_DEPS_PATH", mixCachePath + "/deps")
      .withEnvVariable("MIX_BUILD_ROOT", mixCachePath + "/_build")
      .withEnvVariable("HEX_CACERTS_PATH", "/etc/ssl/certs/ca-certificates.crt")
      .withMountedCache(mixCachePath, mixCache(modSource), sharing: CacheSharingMode.LOCKED)
      .withMountedDirectory(modSourceDirPath, sourceDir)
      .withWorkdir(workdir)
      .withExec(["sh", "-c", buildScript, "build", buildPath, entrypointPath])
      .withoutMount(mixCachePath)
      .withEntrypoint([entrypointPath, "-e", invokeExpression(workdir, toElixirModuleName(modName))])
  }

  """
  The cache volume holding a module's `deps` and `_build`, named after where its
  source comes from as well as its name.

  Mix notices an edit from a file's mtime and size, so two copies of one module
  sharing a volume (two checkouts of a repository, say) could leave a changed
  file of the same size and an older mtime uncompiled. A local source is told
  apart by its path on the host, a git source by its commit, and any other source
  by the digest of its content.
  """
  let mixCache(modSource: ModuleSource!): CacheVolume! {
    let kind = modSource.kind
    let origin = if (kind == ModuleSourceKind.LOCAL_SOURCE or kind == ModuleSourceKind.LOCAL) {
      modSource.localContextDirectoryPath + ":" + modSource.sourceSubpath
    } else if (kind == ModuleSourceKind.GIT_SOURCE or kind == ModuleSourceKind.GIT) {
      modSource.asString + "@" + modSource.commit
    } else {
      modSource.digest
    }
    cacheVolume("elixir-sdk-module-" + modSource.moduleName + "-" + origin)
  }

  """
  Whether the module's vendored SDK is committed — `dagger_sdk/mix.exs` exists
  and is non-empty. When it is not, `mix deps.get` would fail on the
  unresolvable `{:dagger, path: "./dagger_sdk"}` dependency, so `moduleRuntime`
  generates the vendored SDK on the fly instead.
  """
  let hasGeneratedFiles(contextDir: Directory!, subPath: String!): Boolean! {
    let relPath = Path(subPath).join(Path(genDir)).join(Path("mix.exs")).string
    let present = contextDir.exists(path: relPath, expectedType: ExistsType.REGULAR_TYPE)
    if (present) { contextDir.file(relPath).size > 0 } else { false }
  }

  """
  The Elixir SDK source shipped alongside this runtime, pulled into the module
  context by the `../sdk` include patterns in dagger-module.toml.
  """
  let sdkSourceDir: Directory! { currentModule.source.directory("../sdk") }

  """
  The SDK as it is vendored into a module: just enough to compile against.

  Kept in step with vendoredSdk in mod.dang, which produces the same directory
  at `dagger generate` time; this one only exists so an ungenerated module can
  load.
  """
  let vendoredSdk(introspectionJSON: File!): Directory! {
    sdkSourceDir
      .filter(include: ["LICENSE", "mix.exs", "mix.lock", ".formatter.exs", "lib/**/*.ex"])
      .withoutDirectory("lib/dagger/gen")
      .withDirectory("lib/dagger/gen", generatedBindings(introspectionJSON))
  }

  """
  Run the code generator over the module's introspection schema and return the
  generated API bindings, laid out by the generator itself.

  The generator comes prebuilt from `codegenImage`: a static executable on an
  otherwise empty image, so nothing is installed or compiled here.

  Kept in step with generatedBindings in mod.dang.
  """
  let generatedBindings(introspectionJSON: File!): Directory! {
    container
      .from(codegenImage)
      .withMountedFile("/schema.json", introspectionJSON)
      .withExec([
        "/dagger_codegen",
        "generate",
        "--outdir",
        "/gen",
        "--introspection",
        "/schema.json",
      ])
      .directory("/gen")
  }

  let baseContainer(ctr: Container!): Container! {
    ctr
      .from(elixirImage)
      .withExec(["apk", "add", "--no-cache", "git"])
      .withExec(["mix", "local.hex", "--force"])
      .withExec(["mix", "local.rebar", "--force"])
  }
}

"""
The expression every call evaluates: what the SDK's `dagger.entrypoint.invoke`
Mix task does, without Mix.

The engine starts a call in its own working directory, so the expression first
moves to the module's `workdir`, where the Mix task used to run (`mix cmd --cd`),
and applies the module's `config/config.exs` from there, as Mix would have
loaded it. Only `Dagger.Mod.invoke/1` is called, so this works with a
`dagger_sdk/` vendored by an older SDK.
"""
let invokeExpression(workdir: String!, module: String!): String! {
  "File.cd!(\"" + workdir + "\")\n" +
    "if File.regular?(\"config/config.exs\") do\n" +
    "  Application.put_all_env(Config.Reader.read!(\"config/config.exs\", env: :prod, target: :host), persistent: true)\n" +
    "end\n" +
    "Application.ensure_all_started(:dagger)\n" +
    "module = Module.concat(String.split(\"" + module + "\", \".\"))\n" +
    "Code.ensure_loaded?(module) || raise(\"Cannot find module \" <> inspect(module))\n" +
    "Dagger.Mod.invoke(module)"
}

"""
Convert a Dagger module name into an Elixir application name ("my-module" ->
"my_module").

Kept byte-for-byte in step with elixirAppName in
helpers/render-template/main.go, which derives the same name at init time.
"""
let toElixirApplicationName(name: String!): String! {
  name
    .replaceMatches(`([A-Z]+)([A-Z][a-z])`, with: "$1_$2")
    .replaceMatches(`([a-z0-9])([A-Z])`, with: "$1_$2")
    .replaceMatches(`[^A-Za-z0-9]+`, with: "_")
    .trim("_")
    .toLower
}

"""
Convert a Dagger module name into an Elixir module name ("my-module" ->
"MyModule").

Kept byte-for-byte in step with elixirModuleName in
helpers/render-template/main.go: this derives the entrypoint's module name at
call time, that one derives the `defmodule` name at init time, and a divergence
means the entrypoint names a module that does not exist.
"""
let toElixirModuleName(name: String!): String! {
  toElixirApplicationName(name)
    .split("_")
    .map { word => word.rewriteMatches(`^.`) { first => first.string.toUpper } }
    .join("")
}
