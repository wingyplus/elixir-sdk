# Prebuilt code generator image, published from codegen/ by
# `dagger call codegen publish` and pinned by digest. `dagger call codegen pin`
# rewrites this constant here and in runtime/main.dang.
let codegenImage = "docker.io/wingyplus/elixir-sdk-codegen:0.1.0@sha256:778f7f0d8ad7641e261f7c19a86db40fba78195f956cd4319ceccbe993d67909"

"""
A Dagger module that uses the Elixir SDK.
"""
type Mod {
  """
  Workspace-root-relative path of this module root. This stable identity is
  independent of the client's cwd.
  """
  pub rootPath: String!

  """
  The workspace this module belongs to.
  """
  let ws: Workspace!

  """
  Marker filename that skips generate when found at or above this module root.
  """
  let skipGenerateFilename: String!

  """
  Directory the vendored SDK is written to, relative to the module's source
  directory — where the module's `mix.exs` sits and depends on it by path.
  """
  let genDir: String! = "dagger_sdk"

  """
  Module root relative to the client's cwd.
  """
  pub path: String! {
    let cwd = ws.cwd.trimPrefix("/").trimSuffix("/")
    if (rootPath == cwd) {
      "."
    } else if (cwd == "") {
      rootPath
    } else if (rootPath.trimPrefix(cwd + "/") != rootPath) {
      rootPath.trimPrefix(cwd + "/")
    } else if (rootPath == "." or cwd.trimPrefix(rootPath + "/") != cwd) {
      let depth = if (rootPath == ".") { 0 } else { rootPath.split("/").length }
      cwd.split("/").dropFirst(depth).map { segment => ".." }.join("/")
    } else {
      rootPath
    }
  }

  """
  Whether this module or an ancestor contains the configured generate skip marker.
  """
  pub skipGenerate: Boolean! {
    ws.findUp(name: skipGenerateFilename, from: rootPath) != null
  }

  """
  Generate this module: vendor the Elixir SDK and the API bindings generated from
  the module's schema into `<module source>/dagger_sdk`.

  If the generate skip marker is present, the changeset is empty.
  """
  pub generate: Changeset! {
    generatedWorkspace(ws).changes(ws)
  }

  """
  Return `into` with this module's vendored SDK and API bindings applied.

  Staging through the workspace rather than diffing directories is what lets
  `generateAll` fold several modules together, and hands the changeset's cwd
  measurement to the engine (the v1.0.0-beta.10 cutover) so a generate driven
  from a subdirectory lands its files in the right place.

  If the generate skip marker is present, `into` comes back untouched.
  """
  pub generatedWorkspace(into: Workspace!): Workspace! {
    if (skipGenerate) {
      into
    } else {
      # Stage this module's local dependency closure first (leaf-first, possibly
      # across SDKs) so its codegen sees up-to-date dependency bindings.
      #
      # rootPath is workspace-root-relative, so anchor it at "/" before passing it
      # to the cwd-relative Workspace.moduleSource.
      let stagedWs = into.withChanges(
        into.moduleSource("/" + rootPath).generateLocalDependencies(into),
      )
      let modSource = stagedWs.moduleSource("/" + rootPath)
      let vendored = vendoredSdk(modSource.introspectionSchemaJSON)
      # Anchored at the module's source directory, not at its root: the two
      # differ when the module config points its source elsewhere, and it is the
      # source directory that holds the `mix.exs` depending on `./dagger_sdk` —
      # and where the runtime looks for it.
      let genPath = "/" + joinPath(joinPath(rootPath, sourceOffset(modSource)), genDir)

      # Applied onto `into`, not `stagedWs`: the dependency codegen staged above
      # is an input to this module's introspection, never part of its output.
      into.withoutDirectory(genPath).withNewDirectory(genPath, vendored)
    }
  }

  """
  The Elixir SDK source shipped with this module.
  """
  let sdkSourceDir: Directory! { currentModule.source.directory("sdk") }

  """
  The SDK as it is vendored into a module: just enough to compile against.

  Only the files a consuming module needs are kept — the library sources, the
  mix project, `.formatter.exs` (so a module's `import_deps: [:dagger]` resolves)
  and the licence. Everything dev-only stays out: the codegen project (a module
  never regenerates its own SDK), the test suite, and the changelog history.

  The checked-in bindings are then replaced by ones generated from this module's
  own schema.

  Kept in step with vendoredSdk in runtime/main.dang, which builds the same
  directory on the fly when an ungenerated module is loaded.
  """
  let vendoredSdk(introspectionJSON: File!): Directory! {
    sdkSourceDir
      .filter(include: ["LICENSE", "mix.exs", "mix.lock", ".formatter.exs", "lib/**/*.ex"])
      .withoutDirectory("lib/dagger/gen")
      .withDirectory("lib/dagger/gen", generatedBindings(introspectionJSON))
  }

  """
  Run the code generator over the module's introspection schema and return the
  generated API bindings, laid out by the generator itself.

  The generator comes prebuilt from `codegenImage`: a static executable on an
  otherwise empty image, so nothing is installed or compiled here.

  Kept in step with generatedBindings in runtime/main.dang.
  """
  let generatedBindings(introspectionJSON: File!): Directory! {
    container
      .from(codegenImage)
      .withMountedFile("/schema.json", introspectionJSON)
      .withExec([
        "/dagger_codegen",
        "generate",
        "--outdir",
        "/gen",
        "--introspection",
        "/schema.json",
      ])
      .directory("/gen")
  }

  """
  The module's source directory, relative to the module root.

  Usually "." — the two differ when the module config points its source
  elsewhere, as a `dagger-module.toml` at a project root does with
  `source = ".dagger"`, and as a legacy `dagger.json` does with
  `"source": ".dagger"`. `sourceRootSubpath` (the directory holding the config)
  and `sourceSubpath` (the directory holding the source) are both relative to
  the module's context directory, so their difference is the offset from the
  module root whatever that context directory happens to be.
  """
  let sourceOffset(modSource: ModuleSource!): String! {
    let root = normalizePath(modSource.sourceRootSubpath)
    let sub = normalizePath(modSource.sourceSubpath)
    if (sub == root) {
      "."
    } else if (root == ".") {
      sub
    } else {
      sub.trimPrefix(root + "/")
    }
  }

  """
  Join a module path with a sub-path, handling the root (".") module and the
  empty (".") sub-path.
  """
  let joinPath(modPath: String!, sub: String!): String! {
    if (modPath == ".") { sub } else if (sub == ".") { modPath } else { modPath + "/" + sub }
  }

  """
  Normalize a path to a workspace-relative form, with "." for the root.
  """
  let normalizePath(path: String!): String! {
    let normalized = path.trimPrefix("./").trimPrefix("/").trimSuffix("/")
    if (normalized == "") { "." } else { normalized }
  }
}
